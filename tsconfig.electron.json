{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "db/*": ["db/*"]
    }
  },
  "include": ["electron-main/**/*", "shared/**/*", "db/**/*"],
  "exclude": ["node_modules", "**/*.test.ts", "renderer", "dist"]
}
